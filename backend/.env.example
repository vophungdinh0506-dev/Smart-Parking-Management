# Copy file này thành ".env" (cùng thư mục) rồi điền giá trị thật.
# File .env chứa mật khẩu → KHÔNG commit lên Git (đã có trong .gitignore).

NODE_ENV=development
PORT=3000

# ---- Đăng nhập ----
# Khóa bí mật để ký phiên đăng nhập (JWT). Dài >= 32 ký tự, mỗi máy một chuỗi khác nhau.
# Tạo chuỗi ngẫu nhiên: npm run gen-secret  → copy kết quả dán vào đây
JWT_SECRET=
SESSION_HOURS=8`
LOGIN_MAX_ATTEMPTS_PER_MINUTE=5

# ---- SQL Server ----
DB_SERVER=localhost
# Dùng 1 trong 2 cách:
#  (a) Cổng cố định (mặc định 1433):
DB_PORT=1433
#  (b) Tên instance, ví dụ SQL Server Express cài mặc định là SQLEXPRESS
#      (cần bật dịch vụ "SQL Server Browser"). Điền thì DB_PORT bị bỏ qua.
DB_INSTANCE=
DB_NAME=SmartParking
DB_USER=parking_app
DB_PASSWORD=DoiMatKhauNay_123!
DB_ENCRYPT=false
DB_TRUST_SERVER_CERTIFICATE=true

# ---- Module nhận diện biển số (Python) ----
AI_SERVICE_URL=http://localhost:8000
AI_TIMEOUT_MS=10000
AI_CONFIDENCE_THRESHOLD=0.85

# ---- Lưu ảnh ----
UPLOAD_DIR=uploads
UPLOAD_MAX_MB=5
RECOGNITION_MAX_AGE_MINUTES=30
